// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

generator zod {
  provider                  = "prisma-zod-generator"
  output                    = "../src/generated/zod" // Adjust path to point into your Next.js project
  useMultipleFiles          = true                   // Breaks schemas into individual files for clean imports
  createInputTypes          = false                   // Generates input validation blocks (Create, Update, etc.)
  addPrismaProtectedSymbols = false                  // ✅ CRITICAL: Removes Node.js 'fs' links for frontend safety
  createRelationValuesTypes = false
  addSelectTypes           = false 
  addIncludeTypes          = false
}

enum GlobalRole {
  ADMIN
  MEMBER
}

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  WAITING_FOR_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                String          @id @default(uuid()) @db.Uuid
  email             String          @unique
  username          String          @unique
  passwordHash      String
  name              String
  mobileNumber      String?
  avatarUrl         String?
  isActive          Boolean         @default(true)
  role              GlobalRole      @default(MEMBER)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  ownedProjects     Project[]       @relation("ProjectOwner")
  projectMembers    ProjectMember[]
  assignedTasks     Task[]          @relation("TaskAssignee")
  reportedTasks     Task[]          @relation("TaskReporter")
  attachments       TaskAttachment[]
  comments          TaskComment[]
}

model Project {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  key           String          @unique
  iconUrl       String?
  description   String?         @db.Text
  ownerId       String?         @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  owner         User?           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members       ProjectMember[]
  tasks         Task[]
}

model ProjectMember {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  userId     String   @db.Uuid
  assignedAt DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId]) // Compound constraint to prevent multi-assignments
}

model Task {
  id             String          @id @default(uuid()) @db.Uuid
  key            String          @unique
  title          String          @db.VarChar(100)
  description    String?         @db.Text
  status         TaskStatus      @default(TO_DO)
  priority       TaskPriority    @default(LOW)
  estimatedHours Int
  projectId      String          @db.Uuid
  assigneeId     String?         @db.Uuid
  reporterId     String?         @db.Uuid
  sequenceNumber Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee       User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter       User?           @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  attachments    TaskAttachment[]
  comments       TaskComment[]

  @@index([projectId, status])
  @@index([assigneeId])
}

model TaskAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @db.Uuid
  fileUrl      String
  fileName     String
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  authorId  String   @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
